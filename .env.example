# Client — read by the game and by web/. Both are compiled into the bundle, so
# neither is a secret: the anon key is the publishable one and is scoped by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: override the published-version endpoint the update check polls.
# Defaults to https://domebreak.com/version.json (emitted by the web build).
VITE_UPDATE_URL=

# Match server — server/ only, loaded by its systemd unit on the VPS. Every one
# has a default in server/config.js; listing them is what makes the defaults
# visible to somebody bringing a second server up.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GD_PORT=
GD_WS_URLS=
GD_TICK_MS=
GD_SNAPSHOT_MS=
GD_MIN_PLAYERS=
GD_MAX_PLAYERS=
GD_MAX_MATCHES=
GD_MATCH_WINDOW_MS=
GD_MATCH_START_PAUSE_S=
GD_LOBBY_READY_TIMEOUT_MS=
GD_QUEUE_STALE_MS=
GD_RECONNECT_GRACE_S=
GD_ABANDON_GRACE_S=
